# =====================
# Database（Rails）
# =====================
DB_HOST=db
DB_PORT=5432
DB_NAME=shelfie_development
DB_USER=postgres
DB_PASSWORD=

# =====================
# Database（PostgreSQL コンテナ初期化用）
# =====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=shelfie_development

# =====================
# JWT
# =====================
# 署名鍵は専用の環境変数ではなく Rails の secret_key_base を使う（lib/token_issuer.rb）。
# 独立した変数を置くと「設定したのに効いていない秘密」になるため用意しない。

# =====================
# OAuth（Google / GitHub）
# =====================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# redirect_uri の組立に使う（このアプリ自身の公開 URL。末尾スラッシュなし）
API_BASE_URL=http://localhost:8080
# OAuth 完了後のリダイレクト先（フロントエンド。params 由来の値は混ぜない）
FRONTEND_URL=http://localhost:3000

# =====================
# 楽天ブックスAPI
# =====================
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_ORIGIN=

# =====================
# CORS
# =====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =====================
# Cookie
# =====================
# 本番でフロントとバックエンドが親ドメインを共有する場合に設定する（例: .shelfie.jp）
# 未指定時はホストオンリー Cookie として発行される（ローカル開発はこれで OK）
COOKIE_DOMAIN=
