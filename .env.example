# =====================
# Database（Rails）
# =====================
DB_HOST=db
DB_PORT=5432
DB_NAME=shelfie_development
DB_USER=postgres
DB_PASSWORD=

# =====================
# Database（PostgreSQL コンテナ初期化用）
# =====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=shelfie_development

# =====================
# JWT
# =====================
# 4種のトークン（access / refresh / signup / oauth_state）の署名鍵。
# secret_key_base とは分ける（認証トークンだけをローテーションできるようにするため）。
# 生成: docker compose exec web bin/rails secret
# 開発とテストは未設定でも既定値で動く。production は未設定だと起動に失敗する。
JWT_SECRET_KEY=

# =====================
# OAuth（Google / GitHub）
# =====================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# redirect_uri の組立に使う（このアプリ自身の公開 URL。末尾スラッシュなし）
API_BASE_URL=http://localhost:8080
# OAuth 完了後のリダイレクト先（フロントエンド。params 由来の値は混ぜない）
FRONTEND_URL=http://localhost:3000

# =====================
# 楽天ブックスAPI
# =====================
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_ORIGIN=

# =====================
# CORS
# =====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =====================
# Cookie
# =====================
# 本番でフロントとバックエンドが親ドメインを共有する場合に設定する（例: .shelfie.jp）
# 未指定時はホストオンリー Cookie として発行される（ローカル開発はこれで OK）
COOKIE_DOMAIN=
